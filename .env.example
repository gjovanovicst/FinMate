# Copy to `.env` before running the stack. `.env` is gitignored — never commit real secrets.
#
# These defaults match infra/docker/compose.dev.yml so `pnpm dev:infra` works with no .env at all.
# Production uses a secret manager, never this file (docs/11 §4).

# ---------------------------------------------------------------------------
# PostgreSQL
#
# PORT CONFLICT WARNING: Docker Desktop shares localhost with Windows. If a native
# PostgreSQL is installed on Windows it already holds 0.0.0.0:5432, and this container will
# then come up healthy but with NO host port bound — `docker port finmate-db` returns empty and
# Prisma fails with P1000 "Authentication failed". Check with:
#     netstat.exe -ano | grep ':5432'
# If something is listening, pick another port here (5433 is a good default) and update
# DATABASE_URL to match. This is an environment conflict, not a configuration error.
# ---------------------------------------------------------------------------
POSTGRES_USER=finmate
POSTGRES_PASSWORD=finmate
POSTGRES_DB=finmate
POSTGRES_PORT=5432

# Prisma connection string. `schema=public` is explicit because the extensions live there.
# Keep the port in sync with POSTGRES_PORT above.
DATABASE_URL=postgresql://finmate:finmate@localhost:5432/finmate?schema=public

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# MinIO / object storage (Receipt images — ADR-018)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=finmate
MINIO_ROOT_PASSWORD=finmate-dev-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=finmate-receipts
# The API signs presigned URLs with these. All four S3_* settings are optional: without them the
# `files` module reports storage unavailable instead of returning a URL that cannot work (ADR-023).
# In dev they are the MinIO root credentials, so `pnpm storage:init` can create the bucket.
S3_ACCESS_KEY_ID=finmate
S3_SECRET_ACCESS_KEY=finmate-dev-secret
S3_REGION=us-east-1

# ---------------------------------------------------------------------------
# Web push (browser notifications — ADR-028, task 4.2.9)
#
# Both VAPID keys are REQUIRED for push to be delivered. With either one unset the `WEB_PUSH`
# sender is inert: notification rows stay QUEUED and `dispatchNotifications` reports them skipped
# with a reason, so an unconfigured deployment can see that nothing was sent and why.
#
# Generate a pair once and keep it out of version control — rotating it invalidates every existing
# browser subscription, so a rotation is a re-subscribe campaign, not a redeploy:
#     npx web-push generate-vapid-keys
# VAPID_SUBJECT is a contact URL or `mailto:` the push services may use to reach the operator.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:push@example.com

# ---------------------------------------------------------------------------
# Email (Mailhog in dev — no real mail is sent, everything is captured)
# ---------------------------------------------------------------------------
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
SMTP_URL=smtp://localhost:1025

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
NODE_ENV=development
# The port the API binds when it is started directly (node, a container, CI).
# `nx run api:serve` — and therefore `pnpm dev` — overrides this to 3001, because
# apps/web/proxy.conf.json proxies /api and /graphql to 3001. Change one and you must
# change the other, or the SPA gets a proxy failure that reads like an auth error.
API_PORT=3000
# Placeholder only. Production must supply a strong value from a secret manager;
# the config validator refuses to boot outside development with this value.
JWT_SECRET=dev-only-not-a-real-secret-change-me
# The path prefix the BROWSER reaches this API under. It scopes the refresh cookie, and it is
# `/api` here because that is what apps/web/proxy.conf.json exposes (the proxy strips the prefix
# before forwarding, so the API never sees it). Leave it empty when the API is mounted at the
# root. Getting it wrong signs the user out on every hard reload — the cookie is set for a path
# the browser never requests — which is R-26 / task 4.3.5.
PUBLIC_API_PREFIX=/api

# ---------------------------------------------------------------------------
# AI providers
#
# ADR-007: PARSE / CLASSIFY / NARRATE / OCR may only reach a LOCAL model or an EEA-hosted
# endpoint (`_EU` suffix). Anything else is a GDPR Chapter V transfer requiring recorded
# Household consent. Leaving these blank is valid — the pipeline degrades to rules-only.
# ---------------------------------------------------------------------------
AI_PARSE_PRIMARY=LOCAL
AI_CLASSIFY_PRIMARY=LOCAL
# A dev deployment that has a consenting Household and a DeepSeek key may name
# `DEEPSEEK_GLOBAL` here — that is what `.env` does, and it is why the assistant narrates in dev. The
# shipped default stays LOCAL: narration carries the Household's own figures (docs/04 §9).
AI_NARRATE_PRIMARY=LOCAL
AI_OCR_PRIMARY=LOCAL

# Optional provider credentials (all unused while primaries are LOCAL).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# An `*_EU` endpoint has NO default host (ADR-031): naming one as a task primary requires
# its base URL below, and the provider's own platform is not in the EEA.
DEEPSEEK_EU_BASE_URL=
OPENAI_EU_BASE_URL=
ANTHROPIC_EU_BASE_URL=
GEMINI_EU_BASE_URL=
DEEPSEEK_API_KEY=
# DeepSeek's own platform is NOT an EEA endpoint (ADR-031). It is named `DEEPSEEK_GLOBAL` for that
# reason, and naming it as a task primary is a consent-gated exception, never a default: the router
# asks the Household's recorded consent before it opens a socket, and refuses otherwise. A
# deployment that wants AI without asking anyone should configure an EEA-hosted `*_EU` endpoint (or a
# local model) instead.
#
# Base URL for a locally hosted model, e.g. Ollama. DELIBERATELY BLANK. Setting it is a claim that a
# model is listening there, and the composition root takes that claim at its word: with it set, every
# `LOCAL`-routed task opens a socket, and with it blank the task is unrouted and the pipeline settles
# at rules and keywords instantly. The old default pointed at a port nothing listened on.
LOCAL_AI_BASE_URL=

# ---------------------------------------------------------------------------
# Seed (optional)
#
# `pnpm db:seed` with no ids seeds only the global merchant reference data (~38 merchants),
# which has no Household. Set both to seed a complete demo Household: the starter Serbian
# category tree, its keywords, accounts and merchant-category links (docs/01 §5).
# ---------------------------------------------------------------------------
SEED_HOUSEHOLD_ID=
SEED_OWNER_USER_ID=
