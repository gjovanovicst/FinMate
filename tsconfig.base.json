{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": ".",

    /* Strictness. `noUncheckedIndexedAccess` matters more than usual here:
       ledger and split aggregation index into arrays of minor-unit amounts. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "removeComments": false,

    /* NestJS relies on decorator metadata for DI. */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "paths": {
      "@finmate/domain": ["packages/domain/src/index.ts"],
      "@finmate/contracts": ["packages/contracts/src/index.ts"],
      "@finmate/nlp": ["packages/nlp/src/index.ts"],
      "@finmate/rules-engine": ["packages/rules-engine/src/index.ts"],
      "@finmate/ai": ["packages/ai/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "**/node_modules/*"]
}
