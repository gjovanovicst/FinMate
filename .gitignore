# Dependencies
node_modules/

# Workspace-local pnpm store and npm cache.
# Required in this environment: the file sandbox denies writes outside the project,
# and pnpm's default store lives outside it. Never commit — it is a package cache.
.pnpm-store/
.npm-cache/

# Build output
dist/
build/
out-tsc/
tmp/
*.tsbuildinfo

# Nx / Angular / caching
.nx/
.cache/
.angular/

# Test & coverage
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# Environment & secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key

# Local Docker/bind-mount data
infra/data/
infra/backups/

# Editor & OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Prisma / generated clients
**/generated/
prisma/*.db

# Evaluation-harness artefacts (docs/10 §5). The runner writes a report; nothing in it is source.
apps/api/.evals/

# Verification artifacts (screenshots, reports). Regenerate with the audit script; never committed.
.artifacts/
