# pnpm's default store lives outside this workspace; the file sandbox only permits
# writes under the project, so keep the store local. Gitignored — never commit it.
store-dir=.pnpm-store

# Internal packages are consumed as source via tsconfig paths, but peers are
# auto-installed so a missing peer cannot silently break the build.
auto-install-peers=true
strict-peer-dependencies=false

# Keep the lockfile deterministic across machines.
resolution-mode=highest

# NOTE: `node-linker` deliberately is NOT set here. pnpm 10+ moved that setting to
# pnpm-workspace.yaml (as `nodeLinker`), so a `node-linker` line in .npmrc is silently ignored —
# verified with `pnpm config get node-linker` returning undefined. We keep pnpm's default
# isolated linker: it is the safer layout, and the only cost is referencing nested binaries
# explicitly (e.g. apps/api/node_modules/.bin/jest) in Nx target commands.
