{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/*.css",
          "/*.js",
          "/manifest.webmanifest",
          "/icon-192.png",
          "/icon-512.png",
          "/icon-maskable-512.png",
          "/apple-touch-icon.png"
        ]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/graphql",
    "!/api/**",
    "!/auth/**",
    "!/v1/**",
    "!/health",
    "!/health/**"
  ]
}
