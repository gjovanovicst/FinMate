{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "experimentalDecorators": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    /* `ngsw-config.spec.ts` asserts the service-worker configuration — the privacy boundary ADR-024
       makes structural — so it imports `ngsw-config.json`. Reading it with `node:fs` instead is not an
       option: specs are compiled by `web:typecheck` **and** by the production build (see the `include`
       note below), and neither is a Node program. */
    "resolveJsonModule": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    /* `paths` in a child config REPLACES the parent's map rather than merging into it, so the
       workspace aliases are repeated here. They are relative to this file's directory. */
    "baseUrl": ".",
    "paths": {
      "@finmate/domain": ["../../packages/domain/src/index.ts"],
      "@finmate/contracts": ["../../packages/contracts/src/index.ts"],
      "@finmate/nlp": ["../../packages/nlp/src/index.ts"],
      "@finmate/rules-engine": ["../../packages/rules-engine/src/index.ts"],
      "@finmate/ai": ["../../packages/ai/src/index.ts"],
      /* Test-only helpers, deliberately outside `src` so application code cannot import them.
         The same alias is declared in `vitest.config.mts`. */
      "@web-test/*": ["./test/*"]
    }
  },
  /* Specs are included on purpose. They used to be excluded, which meant `web:typecheck` checked
     none of them — and it also broke the transform: Vite resolves a file's tsconfig by path, and a
     file the tsconfig excludes is transformed without `experimentalDecorators`, so an `@Component`
     in a spec failed with a bare "Invalid or unexpected token" (see capture.component.spec.ts). */
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
