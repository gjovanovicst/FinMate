{
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "target": "es2022",
    "keepClassNames": true,
    "baseUrl": "../..",
    "paths": {
      "@finmate/domain": [
        "packages/domain/src/index.ts"
      ],
      "@finmate/contracts": [
        "packages/contracts/src/index.ts"
      ],
      "@finmate/nlp": [
        "packages/nlp/src/index.ts"
      ],
      "@finmate/rules-engine": [
        "packages/rules-engine/src/index.ts"
      ],
      "@finmate/ai": [
        "packages/ai/src/index.ts"
      ],
      "@finmate/api/*": [
        "apps/api/src/*"
      ]
    }
  },
  "module": {
    "type": "commonjs"
  },
  "sourceMaps": true
}
