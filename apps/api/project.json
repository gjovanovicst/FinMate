{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": [
    "scope:api"
  ],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "API_PORT=3001 node --env-file=../../.env -r @swc-node/register src/main.ts",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "production": {
          "command": "node --env-file=../../.env -r @swc-node/register src/main.ts"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "apps/api/node_modules/.bin/vitest run --config apps/api/vitest.config.mts",
        "cwd": "{workspaceRoot}"
      }
    },
    "evals": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --env-file-if-exists=../../.env -r @swc-node/register src/evals/run-evals.ts",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "reportOnly": {
          "command": "node --env-file-if-exists=../../.env -r @swc-node/register src/evals/run-evals.ts --report-only",
          "cwd": "{projectRoot}"
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint .",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo \"apps/api build lands in Phase 0 task 0.9 (bundling strategy for source-consumed packages)\"",
        "cwd": "{projectRoot}"
      }
    },
    "storage:init": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --env-file-if-exists=../../.env -r @swc-node/register src/modules/files/storage-init.ts",
        "cwd": "{projectRoot}"
      }
    }
  }
}
